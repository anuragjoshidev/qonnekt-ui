{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "esModuleInterop": true
  },
  "include": ["src", "scripts", ".storybook", "vitest.config.ts", "tsup.config.ts"],
  "exclude": [
    "src/**/*.test.tsx",
    "src/**/*.test.ts",
    "src/stories",
    "dist",
    "node_modules"
  ]
}

