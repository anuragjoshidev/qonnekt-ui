{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "declaration": true,
    "declarationMap": true,
    "baseUrl": ".",
    "paths": {
      "qonnekt-ui/*": ["./src/components/*"],
      "qonnekt-ui/lib/*": ["./src/lib/*"],
      "qonnekt-ui/hooks/*": ["./src/hooks/*"]
    }
  },
  "include": ["src", "scripts", ".storybook", "vitest.config.ts", "tsup.config.ts"],
  "exclude": ["src/**/*.test.tsx", "src/**/*.test.ts", "dist", "node_modules"]
}
